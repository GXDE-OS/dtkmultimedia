pkgbase=dtkmultimedia-git
pkgver=6.0.5.arch1.r0.gda029d5
pkgrel=1
pkgdesc='Development Tool Kit Multimedia - Deepin multimedia toolkit (Qt 6, local git worktree)'
arch=('x86_64' 'aarch64' 'loong64')
url='https://github.com/linuxdeepin/dtkmultimedia'
license=('LGPL-3.0-or-later')

# x86_64 uses the official extra/onnxruntime-cpu.  aarch64 uses the GXDE
# onnxruntime-cpu-bin package.  Other architectures skip tablerecognizer
# unless explicitly enabled.
case $CARCH in
    x86_64|aarch64) _with_tablerecognizer=${DTKMM_WITH_TABLERECOGNIZER:-1} ;;
    *) _with_tablerecognizer=${DTKMM_WITH_TABLERECOGNIZER:-0} ;;
esac

if [[ $CARCH == aarch64 ]]; then
    _onnxruntime_pkg=onnxruntime-cpu-bin
else
    _onnxruntime_pkg=onnxruntime-cpu
fi

pkgname=(dtkmultimedia-git dtkocr-git)
if (( _with_tablerecognizer )); then
    pkgname+=(dtktablerecognizer-git)
fi

makedepends=(
    'git'
    'cmake'
    'ninja'
    'qt6-base'
    'qt6-multimedia'
    'qt6-tools'
    'dtk6core'
    'dtk6widget'
    'gstreamer'
    'gst-plugins-base-libs'
    'glib2'
    'ffmpeg'
    'mpv'
    'ffmpegthumbnailer'
    'ncnn'
    'opencv'
    'portaudio'
    'v4l-utils'
    'libusb'
    'systemd-libs'
    'libxtst'
    'libglvnd'
)
if (( _with_tablerecognizer )); then
    makedepends+=("$_onnxruntime_pkg")
fi

# Intentionally no source checkout: this is a local-worktree package.
# build() uses $startdir/.. directly, so uncommitted changes are included.
source=()
sha256sums=()

pkgver() {
    cd "$startdir/.."
    local ver
    ver=$(git describe --long --tags --abbrev=7 2>/dev/null) || ver=
    if [[ -n $ver ]]; then
        printf '%s' "$ver" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

prepare() {
    # Arch does not package opencv_mobile.  Provide a pkg-config shim that
    # forwards to the installed OpenCV (opencv5 on current Arch, opencv4
    # fallback) without touching the source tree.
    local opencv_pc opencv_ver
    if pkg-config --exists opencv5; then
        opencv_pc=opencv5
    elif pkg-config --exists opencv4; then
        opencv_pc=opencv4
    else
        error 'OpenCV pkg-config file (opencv5.pc or opencv4.pc) not found'
    fi
    opencv_ver=$(pkg-config --modversion "$opencv_pc")

    mkdir -p "$srcdir/fake-pc"
    printf 'Name: opencv_mobile\nDescription: OpenCV compatibility shim\nVersion: %s\nRequires: %s\n' \
        "$opencv_ver" "$opencv_pc" > "$srcdir/fake-pc/opencv_mobile.pc"
}

build() {
    local tablerec=OFF
    if (( _with_tablerecognizer )); then
        tablerec=ON
    fi

    export PKG_CONFIG_PATH="$srcdir/fake-pc${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    cmake -S "$startdir/.." -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_SKIP_RPATH=ON \
        -DBUILD_DOCS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DDTK_ENABLE_TABLERECOGNIZER=$tablerec
    cmake --build "$srcdir/build"
}

_install() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}

package_dtkmultimedia-git() {
    pkgdesc='Development Tool Kit Multimedia - Core multimedia and widgets libraries (git)'
    provides=('dtkmultimedia')
    conflicts=('dtkmultimedia')
    depends=(
        'qt6-base'
        'qt6-multimedia'
        'dtk6core'
        'dtk6widget'
        'glib2'
        'gstreamer'
        'gst-plugins-base-libs'
        'ffmpeg'
        'mpv'
        'ffmpegthumbnailer'
        'portaudio'
        'v4l-utils'
        'libusb'
        'systemd-libs'
        'libxtst'
        'libglvnd'
    )

    _install

    # Keep only the multimedia + multimediawidgets payload.  The OCR and
    # table-recognizer files are shipped by their own split packages.
    rm -rf "$pkgdir"/usr/include/dtk6ocr
    rm -rf "$pkgdir"/usr/include/dtk6tablerecognizer
    rm -f  "$pkgdir"/usr/lib/libdtk6ocr.so*
    rm -f  "$pkgdir"/usr/lib/libdtk6tablerecognizer.so*
    rm -f  "$pkgdir"/usr/lib/pkgconfig/dtk6ocr.pc
    rm -f  "$pkgdir"/usr/lib/pkgconfig/dtk6tablerecognizer.pc
    rm -rf "$pkgdir"/usr/lib/cmake/dtk6ocr
    rm -rf "$pkgdir"/usr/lib/cmake/dtk6tablerecognizer
    rm -f  "$pkgdir"/usr/lib/qt6/mkspecs/modules/qt_lib_dtk6ocr.pri
    rm -f  "$pkgdir"/usr/lib/qt6/mkspecs/modules/qt_lib_dtk6tablerecognizer.pri
    rm -rf "$pkgdir"/usr/share/libdtk6ocr
    rm -rf "$pkgdir"/usr/share/libdtk6tablerecognizer
}

package_dtkocr-git() {
    pkgdesc='Development Tool Kit OCR - OCR abstraction layer (git)'
    provides=('dtkocr')
    conflicts=('dtkocr')
    depends=(
        'qt6-base'
        'ncnn'
        'opencv'
        'libgomp'
    )

    _install

    # Keep only the OCR payload.
    rm -rf "$pkgdir"/usr/include/dtk6multimedia
    rm -rf "$pkgdir"/usr/include/dtk6multimediawidgets
    rm -rf "$pkgdir"/usr/include/dtk6tablerecognizer
    rm -f  "$pkgdir"/usr/lib/libdtk6multimedia.so*
    rm -f  "$pkgdir"/usr/lib/libdtk6multimediawidgets.so*
    rm -f  "$pkgdir"/usr/lib/libdtk6tablerecognizer.so*
    rm -f  "$pkgdir"/usr/lib/pkgconfig/dtk6multimedia.pc
    rm -f  "$pkgdir"/usr/lib/pkgconfig/dtk6tablerecognizer.pc
    rm -rf "$pkgdir"/usr/lib/cmake/dtk6multimedia
    rm -rf "$pkgdir"/usr/lib/cmake/dtk6tablerecognizer
    rm -f  "$pkgdir"/usr/lib/qt6/mkspecs/modules/qt_lib_dtk6multimedia.pri
    rm -f  "$pkgdir"/usr/lib/qt6/mkspecs/modules/qt_lib_dtk6tablerecognizer.pri
    rm -rf "$pkgdir"/usr/share/libdtk6tablerecognizer
}

package_dtktablerecognizer-git() {
    pkgdesc='Development Tool Kit Table Recognizer - Table structure detection and recognition (git)'
    provides=('dtktablerecognizer')
    conflicts=('dtktablerecognizer')
    depends=(
        'qt6-base'
        'dtkocr-git'
        "$_onnxruntime_pkg"
        'opencv'
    )

    _install

    # Keep only the table-recognizer payload.
    rm -rf "$pkgdir"/usr/include/dtk6multimedia
    rm -rf "$pkgdir"/usr/include/dtk6multimediawidgets
    rm -rf "$pkgdir"/usr/include/dtk6ocr
    rm -f  "$pkgdir"/usr/lib/libdtk6multimedia.so*
    rm -f  "$pkgdir"/usr/lib/libdtk6multimediawidgets.so*
    rm -f  "$pkgdir"/usr/lib/libdtk6ocr.so*
    rm -f  "$pkgdir"/usr/lib/pkgconfig/dtk6multimedia.pc
    rm -f  "$pkgdir"/usr/lib/pkgconfig/dtk6ocr.pc
    rm -rf "$pkgdir"/usr/lib/cmake/dtk6multimedia
    rm -rf "$pkgdir"/usr/lib/cmake/dtk6ocr
    rm -f  "$pkgdir"/usr/lib/qt6/mkspecs/modules/qt_lib_dtk6multimedia.pri
    rm -f  "$pkgdir"/usr/lib/qt6/mkspecs/modules/qt_lib_dtk6ocr.pri
    rm -rf "$pkgdir"/usr/share/libdtk6ocr
}
